{
  "id": "project",
  "label": "Project",
  "repeatable": true,
  "status": true,
  "format": "custom",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": ""
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": ""
        }
      },
      "subtitle": {
        "type": "Text",
        "config": {
          "label": "Subtitle",
          "placeholder": ""
        }
      },
      "images": {
        "type": "Group",
        "config": {
          "label": "Images",
          "fields": {
            "image": {
              "type": "Image",
              "config": {
                "label": "Image",
                "constraint": {
                  "width": null,
                  "height": 1080
                },
                "thumbnails": []
              }
            }
          }
        }
      },
      "images_caption": {
        "type": "StructuredText",
        "config": {
          "label": "Images Caption",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,hyperlink,list-item,o-list-item"
        }
      },
      "categories": {
        "type": "Group",
        "config": {
          "label": "Categories",
          "repeat": true,
          "fields": {
            "category": {
              "type": "Link",
              "config": {
                "label": "Category",
                "select": "document",
                "repeat": false,
                "customtypes": [
                  {
                    "id": "category",
                    "fields": ["title"]
                  }
                ]
              }
            }
          }
        }
      },
      "right_column_text": {
        "type": "StructuredText",
        "config": {
          "label": "Right Column Text",
          "placeholder": "",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,strong,em,hyperlink,embed,list-item,o-list-item,rtl,heading2"
        }
      },
      "color": {
        "type": "Select",
        "config": {
          "label": "Color",
          "placeholder": "",
          "options": [
            "lila",
            "yellow",
            "orange",
            "pink",
            "gold",
            "lime",
            "blue"
          ],
          "default_value": "lila"
        }
      },
      "date": {
        "type": "Date",
        "config": {
          "label": "Date (for order)",
          "placeholder": ""
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "text": {
              "type": "SharedSlice"
            },
            "image": {
              "type": "SharedSlice"
            }
          }
        }
      }
    }
  }
}
